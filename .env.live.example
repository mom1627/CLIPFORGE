# COPY THIS FILE TO .env.live ON YOUR PRIVATE SERVER. Never commit real tokens.
# Only channels whose owners approved recording, editing AND TikTok redistribution.
APPROVED_CHANNELS=kaicenat,xqc,montanablack88,trymacs,papaplatte,caseoh_
CAPTURE_INTERVAL_MINUTES=120
MAX_CLIPS_PER_DAY=8
CAPTURE_SECONDS=100
CLIP_SECONDS=38
VIDEO_WIDTH=720
ALLOWED_GAMES=Grand Theft Auto VI
# Optional official Twitch Helix category filter; required to verify the game for TikTok uploads.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Official TikTok "video.upload": these are for the TikTok account that explicitly authorizes CLIPFORGE.
# Keep these values private, refresh tokens rotate.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_UPLOAD_MODE=draft
ALLOW_UNVERIFIED_GAME_UPLOAD=false
